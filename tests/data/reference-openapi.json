{
  "components": {
    "schemas": {
      "AnalysisRequest": {
        "properties": {
          "base_commit": {
            "anyOf": [
              {
                "pattern": "^[0-9a-fA-F]{7,40}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Base commit SHA; defaults to the first parent of commit_id",
            "title": "Base Commit"
          },
          "commit_id": {
            "description": "Head commit SHA (7-40 hex)",
            "pattern": "^[0-9a-fA-F]{7,40}$",
            "title": "Commit Id",
            "type": "string"
          },
          "repository": {
            "description": "GitHub repository as owner/name",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})/[A-Za-z0-9._-]{1,100}$",
            "title": "Repository",
            "type": "string"
          }
        },
        "required": [
          "repository",
          "commit_id"
        ],
        "title": "AnalysisRequest",
        "type": "object"
      },
      "AnalysisResult": {
        "properties": {
          "analysis_id": {
            "title": "Analysis Id",
            "type": "string"
          },
          "base_commit": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Base Commit"
          },
          "changes": {
            "items": {
              "$ref": "#/components/schemas/Change"
            },
            "title": "Changes",
            "type": "array"
          },
          "config_version": {
            "title": "Config Version",
            "type": "string"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorBody"
              },
              {
                "type": "null"
              }
            ]
          },
          "head_commit": {
            "title": "Head Commit",
            "type": "string"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/Finding"
            },
            "title": "Issues",
            "type": "array"
          },
          "repository": {
            "title": "Repository",
            "type": "string"
          },
          "skipped": {
            "items": {
              "$ref": "#/components/schemas/Skipped"
            },
            "title": "Skipped",
            "type": "array"
          },
          "status": {
            "enum": [
              "SUCCESS",
              "ERROR"
            ],
            "title": "Status",
            "type": "string"
          },
          "tool_version": {
            "title": "Tool Version",
            "type": "string"
          }
        },
        "required": [
          "analysis_id",
          "repository",
          "head_commit",
          "base_commit",
          "config_version",
          "tool_version",
          "status",
          "error",
          "issues",
          "changes",
          "skipped",
          "created_at"
        ],
        "title": "AnalysisResult",
        "type": "object"
      },
      "Change": {
        "properties": {
          "category": {
            "enum": [
              "IMPLEMENTATION",
              "DESIGN",
              "ARCHITECTURE",
              "SPECIFICATION",
              "REQUIREMENT",
              "OTHER"
            ],
            "title": "Category",
            "type": "string"
          },
          "change_type": {
            "enum": [
              "ADDED",
              "MODIFIED",
              "DELETED",
              "RENAMED",
              "COPIED",
              "TYPE_CHANGED"
            ],
            "title": "Change Type",
            "type": "string"
          },
          "old_path": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Old Path"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "path",
          "change_type",
          "category"
        ],
        "title": "Change",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody",
        "type": "object"
      },
      "Finding": {
        "properties": {
          "change_category": {
            "enum": [
              "IMPLEMENTATION",
              "DESIGN",
              "ARCHITECTURE",
              "SPECIFICATION",
              "REQUIREMENT",
              "OTHER"
            ],
            "title": "Change Category",
            "type": "string"
          },
          "code_file": {
            "title": "Code File",
            "type": "string"
          },
          "documentation_file": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Documentation File"
          },
          "explanation": {
            "title": "Explanation",
            "type": "string"
          },
          "finding_id": {
            "title": "Finding Id",
            "type": "string"
          },
          "issue_type": {
            "title": "Issue Type",
            "type": "string"
          },
          "verification_status": {
            "const": "PENDING_REVIEW",
            "title": "Verification Status",
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "issue_type",
          "code_file",
          "documentation_file",
          "change_category",
          "explanation",
          "verification_status"
        ],
        "title": "Finding",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Skipped": {
        "properties": {
          "path": {
            "title": "Path",
            "type": "string"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "path",
          "reason"
        ],
        "title": "Skipped",
        "type": "object"
      },
      "TestSetupRequest": {
        "properties": {
          "session_id": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Session Id",
            "type": "string"
          },
          "setup": {
            "additionalProperties": true,
            "title": "Setup",
            "type": "object"
          }
        },
        "required": [
          "session_id"
        ],
        "title": "TestSetupRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Teams 15/16 pod project API (Phase 2, Section 5) and course testing endpoints.",
    "title": "Documentation Tracker System",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/analysis/{analysis_id}": {
      "get": {
        "operationId": "get_analysis_analysis__analysis_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "analysis_id",
            "required": true,
            "schema": {
              "title": "Analysis Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Get Analysis",
        "tags": [
          "project"
        ]
      }
    },
    "/analyze": {
      "post": {
        "operationId": "analyze_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalysisResult"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Bad Request"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Internal Server Error"
          }
        },
        "summary": "Analyze",
        "tags": [
          "project"
        ]
      }
    },
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "operations"
        ]
      }
    },
    "/test/report": {
      "get": {
        "operationId": "test_report_test_report_get",
        "parameters": [
          {
            "in": "query",
            "name": "session_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Test Report Test Report Get"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Test Report",
        "tags": [
          "testing"
        ]
      }
    },
    "/test/setup": {
      "post": {
        "operationId": "test_setup_test_setup_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TestSetupRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "title": "Response Test Setup Test Setup Post"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Test Setup",
        "tags": [
          "testing"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/system"
    }
  ]
}
