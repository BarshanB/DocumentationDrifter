# copy to .env and fill in, .env is gitignored

# must match the secret you set on the GitHub webhook
# generate with: openssl rand -hex 32
WEBHOOK_SECRET=

# defaults to <repo root>/drifter.db, uncomment only to override
# a relative sqlite path here resolves against CWD, not the repo
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/drifter
